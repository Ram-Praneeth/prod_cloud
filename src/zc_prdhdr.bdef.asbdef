projection;
strict ( 2 );
use draft;

define behavior for ZC_PRDHDR //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _itm { create; with draft; }
  use association _soldcntry { create; with draft; }
}

define behavior for ZC_PRDITM //alias <alias_name>
{
  use update;
  use delete;

  use association _hdr { with draft; }
}

define behavior for ZC_PRD_SOLD_CNTRY //alias <alias_name>
{
  use update;
  use delete;

  use association _Header { with draft; }
}